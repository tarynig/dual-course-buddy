# Copy this file to .env on the server and fill in real values.
# These settings never live in the site's code. On the college's hosting they are set in the
# server's own environment: cPanel -> Setup Node.js App -> Environment Variables, or in a .env
# file stored outside public_html. The site reads them by name, so moving hosts means copying
# these values, never editing code.

# --- Database (standalone PostgreSQL on the host) -------------------------------------------
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# On cPanel the host is usually localhost and the port 5432.
DATABASE_URL=postgres://user:password@localhost:5432/college_database

# --- Outgoing mail (the college's own mailbox, standard SMTP) --------------------------------
# cPanel -> Email Accounts -> Connect Devices shows the server name and ports.
SMTP_HOST=mail.creativearts.co.za
# 465 = SSL (recommended). Use 587 for STARTTLS and set SMTP_SECURE=false in that case.
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=enquiries@creativearts.co.za
SMTP_PASS=the mailboxes password
# Optional. Falls back to the mailbox address above when left empty.
SMTP_FROM="Creative Arts College" <enquiries@creativearts.co.za>

# --- Who receives new-enquiry alerts ---------------------------------------------------------
# Comma separated. Left empty, no alerts are sent and the site logs a warning.
ADMISSIONS_EMAIL=enquiries@creativearts.co.za
